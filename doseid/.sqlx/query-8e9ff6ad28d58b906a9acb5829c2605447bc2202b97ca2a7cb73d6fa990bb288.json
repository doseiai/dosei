  "query": "INSERT INTO node (id, ip, port, is_main, last_heartbeat_at, created_at)\n       VALUES ($1, $2, $3, $4, $5, $6)\n       ON CONFLICT (ip) DO UPDATE SET\n         port = EXCLUDED.port,\n         is_main = EXCLUDED.is_main,\n         last_heartbeat_at = EXCLUDED.last_heartbeat_at\n       RETURNING *",
